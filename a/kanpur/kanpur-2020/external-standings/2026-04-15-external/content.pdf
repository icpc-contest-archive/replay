<!-- ===================== JS ===================== -->
<script>

/* TYPEWRITER */
const TW = document.getElementById("typewriter");
const TWtext = "Welcome to ICPC Kanpur Site";
let idx = 0;
(function type(){ if(idx<TWtext.length){ TW.textContent += TWtext[idx++]; setTimeout(type,60);} })();

/* SLIDESHOW */
const images = [
  "images/2024/event1.jpg","images/2024/event2.jpg","images/2024/event3.jpg",
  "images/2024/event4.jpg","images/2024/event5.jpg","images/2024/event6.jpg",
  "images/2024/event7.jpg"
];
const shuffled = images.sort(()=>Math.random()-0.5);
const slideshow = document.getElementById("slideshow-layer");

shuffled.forEach((src,i)=>{
  const img=document.createElement("img");
  img.src=src;
  img.className="hero-slide";
  img.style.animationDelay=`${i*6}s`;
  slideshow.appendChild(img);
});

/* PARTICLES */
const canvas=document.getElementById("particles-canvas"), ctx=canvas.getContext("2d");
canvas.width=window.innerWidth; canvas.height=window.innerHeight;
let parts=[];

for(let i=0;i<50;i++){
  parts.push({
    x:Math.random()*canvas.width,
    y:Math.random()*canvas.height,
    r:Math.random()*2+1,
    dy:Math.random()*0.6+0.3
  });
}

function animate(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  parts.forEach(p=>{
    ctx.beginPath();
    ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
    ctx.fillStyle="rgba(255,255,255,0.6)";
    ctx.fill();
    p.y -= p.dy;
    if(p.y<0) p.y=canvas.height;
  });
  requestAnimationFrame(animate);
}
animate();

/* ================= ICPC CONTEST TIMER ================= */
(function () {

  const statusEl = document.getElementById("contestStatus");
  const timerEl  = document.getElementById("contestTimer");
  const wishEl   = document.getElementById("contestWish");

  function getISTNow(){
    const now = new Date();
    return new Date(
      now.toLocaleString("en-US", { timeZone: "Asia/Kolkata" })
    );
  }

  function updateContestTimer(){
    const now   = getISTNow();
    const start = new Date(now); start.setHours(10,0,0,0);
    const end   = new Date(now); end.setHours(15,0,0,0);

    let diff;

    if (now < start) {
      statusEl.innerText = "Contest Starts In";
      wishEl.classList.add("hidden");
      diff = start - now;
    }
    else if (now >= start && now <= end) {
      statusEl.innerText = "Contest Ends In";
      wishEl.classList.remove("hidden");
      diff = end - now;
    }
    else {
      statusEl.innerText = "Contest Concluded";
      timerEl.innerText  = "Thank You";
      wishEl.innerText   =
        "Thank you for competing at the ICPC Asia Regional – Kanpur Site.";
      wishEl.classList.remove("hidden");
      return;
    }

    const h = Math.floor(diff / 3_600_000);
    const m = Math.floor((diff % 3_600_000) / 60_000);
    const s = Math.floor((diff % 60_000) / 1000);

    timerEl.innerText =
      String(h).padStart(2,'0') + " : " +
      String(m).padStart(2,'0') + " : " +
      String(s).padStart(2,'0');
  }

  updateContestTimer();
  setInterval(updateContestTimer, 1000);

})();


</script>

</body>
</html>        </section>
      </div>

