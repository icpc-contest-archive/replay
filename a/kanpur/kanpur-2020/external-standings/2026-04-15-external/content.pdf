  <style>
    :root{
      --gold:#ffcc66;
      --ink:#0f172a;
      --maroon:#3b0b0b;
    }

    /* ------------------------------
       Decorative Effects (Your Existing)
    ------------------------------ */
    .decorative-hero{position:relative;isolation:isolate}
    .decorative-hero::before{
      content:"";position:absolute;inset:-2px;border-radius:inherit;
      background:conic-gradient(from 120deg,#fdba11a3,#22d3ee50,#6366f150,#ec489150,#fdba11a3);
      filter:blur(10px);
      opacity:.25;
      animation:spinGlow 24s linear infinite;
      z-index:0;
      pointer-events:none;
    }
    @keyframes spinGlow { to { transform: rotate(360deg); } }

    @keyframes floaty{
      0%{transform:translate(-22%, -12%) scale(1);opacity:.3}
      50%{transform:translate(10%, 10%) scale(1.05);opacity:.5}
      100%{transform:translate(-22%, -12%) scale(1);opacity:.3}
    }

    .blob{
      position:absolute;
      filter:blur(36px);
      opacity:.3;
      mix-blend-mode:screen;
      animation:floaty 18s ease-in-out infinite;
      pointer-events:none
    }

    .grid-overlay{
      position:absolute;inset:0;
      background:
        linear-gradient(transparent,rgba(0,0,0,.45) 60%,rgba(0,0,0,.7)),
        radial-gradient(circle at 20% 30%,rgba(255,255,255,.04),transparent 40%),
        linear-gradient(to right,rgba(255,255,255,.03) 1px,transparent 1px),
        linear-gradient(to bottom,rgba(255,255,255,.02) 1px,transparent 1px);
      background-size:auto,420px 420px,40px 40px,40px 40px;
      pointer-events:none;
      z-index:1;
    }


    /* ------------------------------
       CLEAN MODERN HERO CSS
    ------------------------------ */

    #hero, #slideshow-layer, .hero-slide {
      overflow: hidden;
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      animation: fadeShow 42s infinite;
    }

    @keyframes fadeShow {
      0% { opacity: 0; }
      10% { opacity: 1; }
      24% { opacity: 1; }
      34% { opacity: 0; }
      100% { opacity: 0; }
    }

    /* Gradient Title Flow */
    @keyframes gradientFlow {
      0% { background-position:0% 50%; }
      50% { background-position:100% 50%; }
      100% { background-position:0% 50%; }
    }
    .animate-gradient {
      background-size:200% 200%;
      animation: gradientFlow 6s ease infinite;
    }

    /* Neon Border */
    .neon-border::after {
      content:"";
      position:absolute;
      inset:0;
      border-radius:inherit;
      border:2px solid transparent;
      background:linear-gradient(120deg, #22d3ee, #facc15, #ef4444, #22d3ee) border-box;
      mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      mask-composite:exclude;
      animation:borderSpin 10s linear infinite;
    }
    @keyframes borderSpin { to { transform: rotate(360deg); } }

    /* Smooth Particles */
    #particles-canvas { pointer-events:none; }

    /* Scroll Indicator */
    .scroll-indicator {
      width:28px; height:28px;
      border-radius:50%;
      background:white;
      color:black;
      display:flex;
      justify-content:center;
      align-items:center;
      font-size:20px;
      animation:bounce 1.6s infinite;
    }
    @keyframes bounce {
      0%,100% { transform:translateY(0); opacity:1; }
      50% { transform:translateY(8px); opacity:0.6; }
    }
  </style>
</head>

