    <!-- ===== MOBILE MENU AND MODAL BEHAVIOUR ===== -->
    <script>
      const menuButton=document.querySelector('.menu');
      const navigationLinks=document.querySelector('.links');

      menuButton.addEventListener('click',()=> {
        const isOpen=navigationLinks.classList.toggle('open');
        menuButton.setAttribute('aria-expanded',isOpen)
      });

      navigationLinks.addEventListener('click',()=> {
        navigationLinks.classList.remove('open');
        menuButton.setAttribute('aria-expanded','false')
      });

      const modalTriggers=document.querySelectorAll('[data-modal-target]');
      const instructionModals=document.querySelectorAll('.instruction-modal');
      const qrZoomButton=document.querySelector('.payment-qr-zoom');
      const qrLightbox=document.getElementById('qr-lightbox');
      const qrLightboxClose=qrLightbox?.querySelector('.qr-lightbox-close');
      const galleryZoomButtons=document.querySelectorAll('.gallery-zoom');
      const galleryLightbox=document.getElementById('gallery-lightbox');
      const galleryLightboxClose=galleryLightbox?.querySelector('.gallery-lightbox-close');
      const galleryLightboxImage=galleryLightbox?.querySelector('.gallery-lightbox-image');
      const galleryLightboxTitle=document.getElementById('gallery-lightbox-title');
      let activeModal=null;
      let lastModalTrigger=null;
      let lastGalleryTrigger=null;

      function getFocusableElements(modal) {
        return [...modal.querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])')]
          .filter(element=>!element.hasAttribute('disabled')&&!element.closest('[hidden]'))
      }

      function openQrLightbox() {
        if(!qrLightbox||!qrZoomButton) return;
        qrLightbox.hidden=false;
        qrZoomButton.setAttribute('aria-expanded','true');
        (qrLightboxClose||qrLightbox.querySelector('.qr-lightbox-panel')).focus()
      }

      function closeQrLightbox() {
        if(!qrLightbox||qrLightbox.hidden) return;
        qrLightbox.hidden=true;
        qrZoomButton?.setAttribute('aria-expanded','false');
        qrZoomButton?.focus()
      }

      function openGalleryLightbox(trigger) {
        if(!galleryLightbox||!galleryLightboxImage) return;
        const image=trigger.querySelector('img');
        const caption=trigger.closest('figure')?.querySelector('figcaption')?.textContent||image.alt||'Gallery image';
        galleryLightboxImage.src=image.currentSrc||image.src;
        galleryLightboxImage.alt=image.alt;
        galleryLightboxTitle.textContent=caption;
        lastGalleryTrigger=trigger;
        galleryLightbox.hidden=false;
        trigger.setAttribute('aria-expanded','true');
        document.body.classList.add('modal-open');
        (galleryLightboxClose||galleryLightbox.querySelector('.gallery-lightbox-panel')).focus()
      }

      function closeGalleryLightbox() {
        if(!galleryLightbox||galleryLightbox.hidden) return;
        galleryLightbox.hidden=true;
        document.body.classList.remove('modal-open');
        if(lastGalleryTrigger) {
          lastGalleryTrigger.setAttribute('aria-expanded','false');
          lastGalleryTrigger.focus()
        }
        lastGalleryTrigger=null
      }

      function openInstructionModal(trigger) {
        const modal=document.getElementById(trigger.dataset.modalTarget);
        if(!modal) return;

        activeModal=modal;
        lastModalTrigger=trigger;
        modal.hidden=false;
        trigger.setAttribute('aria-expanded','true');
        document.body.classList.add('modal-open');

        const closeButton=modal.querySelector('.modal-close');
        (closeButton||modal.querySelector('.instruction-modal-panel')).focus()
      }

      function closeInstructionModal() {
        if(!activeModal) return;

        activeModal.hidden=true;
        document.body.classList.remove('modal-open');
        if(lastModalTrigger) {
          lastModalTrigger.setAttribute('aria-expanded','false');
          lastModalTrigger.focus()
        }
        activeModal=null;
        lastModalTrigger=null
      }

      modalTriggers.forEach(trigger=> {
        trigger.addEventListener('click',()=>openInstructionModal(trigger))
      });

      instructionModals.forEach(modal=> {
        modal.querySelector('.modal-close').addEventListener('click',closeInstructionModal);
        modal.addEventListener('click',event=> {
          if(event.target===modal) closeInstructionModal()
        })
      });

      qrZoomButton?.addEventListener('click',openQrLightbox);
      qrLightboxClose?.addEventListener('click',closeQrLightbox);
      qrLightbox?.addEventListener('click',event=> {
        if(event.target===qrLightbox) closeQrLightbox()
      });

      galleryZoomButtons.forEach(trigger=> {
        trigger.addEventListener('click',()=>openGalleryLightbox(trigger))
      });
      galleryLightboxClose?.addEventListener('click',closeGalleryLightbox);
      galleryLightbox?.addEventListener('click',event=> {
        if(event.target===galleryLightbox) closeGalleryLightbox()
      });

      document.addEventListener('keydown',event=> {
        if(!activeModal&&(galleryLightbox?.hidden??true)) return;

        if(event.key==='Escape') {
          event.preventDefault();
          if(qrLightbox&&!qrLightbox.hidden) {
            closeQrLightbox();
            return
          }
          if(galleryLightbox&&!galleryLightbox.hidden) {
            closeGalleryLightbox();
            return
          }
          closeInstructionModal();
          return
        }

        if(event.key==='Tab') {
          const focusScope=qrLightbox&&!qrLightbox.hidden
            ? qrLightbox
            : galleryLightbox&&!galleryLightbox.hidden
              ? galleryLightbox
              : activeModal;
          const focusable=getFocusableElements(focusScope);
          if(!focusable.length) return;

          const first=focusable[0];
          const last=focusable[focusable.length-1];
          if(event.shiftKey&&document.activeElement===first) {
            event.preventDefault();
            last.focus()
          } else if(!event.shiftKey&&document.activeElement===last) {
            event.preventDefault();
            first.focus()
          }
        }
      });
    </script>
  </body>
</html>
